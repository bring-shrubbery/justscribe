# Workers static assets apply these on top of the defaults (public, max-age=0,
# must-revalidate + ETag). Hashed build output and the fonts never change under
# the same URL, so browsers may keep them for a year.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

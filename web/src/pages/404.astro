---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · JustScribe" description="There is nothing at this address." noindex>
  <main class="not-found">
    <p class="muted">404</p>
    <h1>Nothing here</h1>
    <p>
      The page you asked for does not exist. JustScribe is a single page: <a href="/">go to it</a>,
      or <a href="https://github.com/bring-shrubbery/justscribe/releases/latest">download the latest release</a>.
    </p>
  </main>
</Base>

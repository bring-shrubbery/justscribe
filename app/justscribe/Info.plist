<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A menu bar app: launches without a Dock icon; "Show in Dock" switches the activation policy. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Live Transcription records what other apps play through a Core Audio tap; macOS asks with this text. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>JustScribe records the audio other apps play only while a live transcription that includes system audio is running, to transcribe it on this Mac.</string>
	<!-- Sparkle. The rest of the Info.plist is generated from build settings and merged with this. -->
	<key>SUFeedURL</key>
	<string>https://justscribe.quassum.com/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>iReWrwCRErK8BUS22WVQip5W96fDaoQZm+RXzv4UItk=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<!-- The app is sandboxed: Sparkle installs through its XPC launcher service. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
</dict>
</plist>
